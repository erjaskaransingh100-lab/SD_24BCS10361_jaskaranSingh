amily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="255.7" y="418.8" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n186" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="255.7" y="441.3" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n187" value="Playback / Entitlement Svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="255.7" y="463.9" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n188" value="Subscription / Auth Check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="255.7" y="486.4" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n189" value="Manifest URL -&gt; CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="255.7" y="508.9" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n194" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="491.7" y="403.0" width="236.4" height="118.1" as="geometry"/></mxCell><mxCell id="n195" value="FLOW C - STREAM + WATCH STATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a1c1c;strokeColor=#4a1c1c;fontSize=7;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="491.7" y="403.0" width="236.4" height="12.6" as="geometry"/></mxCell><mxCell id="n196" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="497.6" y="418.8" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n197" value="CDN -&gt; Video Segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="497.6" y="441.3" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n198" value="Watch State Svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="497.6" y="463.9" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n199" value="Kafka (async)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="497.6" y="486.4" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n200" value="NoSQL / Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1f7;strokeColor=#2c4a63;fontSize=6.3;fontColor=#1a1a1a;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="497.6" y="508.9" width="224.6" height="10.2" as="geometry"/></mxCell><mxCell id="n205" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="7.9" y="527.4" width="175.9" height="263.7" as="geometry"/></mxCell><mxCell id="n206" value="SCALABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#154d8a;strokeColor=#154d8a;fontSize=7.4;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="7.9" y="527.4" width="175.9" height="18.1" as="geometry"/></mxCell><mxCell id="n207" value="• Stateless API services&lt;br&gt;• Horizontal autoscaling&lt;br&gt;• Redis caching layer&lt;br&gt;• CDN offloading of video&lt;br&gt;• Database replication&lt;br&gt;• Partitioned NoSQL stores&lt;br&gt;• Kafka for async events&lt;br&gt;• Search index for discovery&lt;br&gt;• Regional deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=6.8;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="10.2" y="547.1" width="171.2" height="241.7" as="geometry"/></mxCell><mxCell id="n208" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="189.3" y="527.4" width="175.9" height="263.7" as="geometry"/></mxCell><mxCell id="n209" value="RELIABILITY / FAULT TOLERANCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#2e7d32;fontSize=7.4;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="189.3" y="527.4" width="175.9" height="18.1" as="geometry"/></mxCell><mxCell id="n210" value="• Multi-region deployment&lt;br&gt;• No single point of failure&lt;br&gt;• Database replication&lt;br&gt;• CDN redundancy&lt;br&gt;• Retry with backoff&lt;br&gt;• Circuit breakers&lt;br&gt;• Graceful degradation&lt;br&gt;• Health checks&lt;br&gt;• Async processing via Kafka&lt;br&gt;• Backups / disaster recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=6.8;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="191.7" y="547.1" width="171.2" height="241.7" as="geometry"/></mxCell><mxCell id="n211" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="370.8" y="527.4" width="175.9" height="263.7" as="geometry"/></mxCell><mxCell id="n212" value="SECURITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a1c1c;strokeColor=#7a1c1c;fontSize=7.4;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="370.8" y="527.4" width="175.9" height="18.1" as="geometry"/></mxCell><mxCell id="n213" value="• TLS in transit&lt;br&gt;• Encryption at rest&lt;br&gt;• OAuth / JWT / session auth&lt;br&gt;• Role-based authorization&lt;br&gt;• DRM for protected video&lt;br&gt;• Rate limiting&lt;br&gt;• API input validation&lt;br&gt;• Secure payment processing&lt;br&gt;• Audit logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=6.8;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="373.1" y="547.1" width="171.2" height="241.7" as="geometry"/></mxCell><mxCell id="n214" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="552.2" y="527.4" width="175.9" height="263.7" as="geometry"/></mxCell><mxCell id="n215" value="DESIGN TRADE-OFFS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5a3d8a;strokeColor=#5a3d8a;fontSize=7.4;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="552.2" y="527.4" width="175.9" height="18.1" as="geometry"/></mxCell><mxCell id="n216" value="&lt;b&gt;SQL vs NoSQL&lt;/b&gt;&lt;br&gt;SQL: transactional correctness; NoSQL: high-volume distributed state.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sync vs Async&lt;/b&gt;&lt;br&gt;Sync for user-critical ops; Kafka for analytics/events.&lt;br&gt;&lt;br&gt;&lt;b&gt;Origin vs CDN&lt;/b&gt;&lt;br&gt;Origin: durable storage; CDN: cuts latency &amp; bandwidth load.&lt;br&gt;&lt;br&gt;&lt;b&gt;Strong vs Eventual&lt;/b&gt;&lt;br&gt;Strong where correctness matters; eventual where throughput/availability matter more." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=6.8;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="554.6" y="547.1" width="171.2" height="241.7" as="geometry"/></mxCell><mxCell id="n217" value="FINAL DESIGN PRINCIPLE:   Separate control-plane operations from the video data plane; keep APIs stateless, push video delivery to the edge, and use asynchronous events for high-volume telemetry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c2b39;strokeColor=#1c2b39;fontSize=8.5;fontColor=#ffffff;fontStyle=1;align=left;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="7.9" y="799.0" width="1153.3" height="21.6" as="geometry"/></mxCell><mxCell id="n218" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="740.0" y="43.3" width="421.2" height="149.6" as="geometry"/></mxCell><mxCell id="n219" value="FUNCTIONAL REQUIREMENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c2b39;strokeColor=#1c2b39;fontSize=7.6;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="740.0" y="43.3" width="421.2" height="14.2" as="geometry"/></mxCell><mxCell id="n220" value="• User registration &amp; auth&lt;br&gt;• User profiles&lt;br&gt;• Subscription &amp; billing&lt;br&gt;• Browse catalog&lt;br&gt;• Search movies / shows&lt;br&gt;• Personalized recs&lt;br&gt;• Video playback&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=7;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="743.9" y="59.0" width="204.7" height="129.9" as="geometry"/></mxCell><mxCell id="n221" value="• Adaptive bitrate streaming&lt;br&gt;• Continue watching / resume&lt;br&gt;• Watch history &amp; ratings&lt;br&gt;• Content upload&lt;br&gt;• Transcoding &amp; packaging&lt;br&gt;• CDN-based delivery&lt;br&gt;• Analytics &amp; event collection&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=7;align=left;verticalAlign=top;spacing=4;" vertex="1" parent="1"><mxGeometry x="952.5" y="59.0" width="204.7" height="129.9" as="geometry"/></mxCell><mxCell id="n222" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a7a7a;fontSize=9;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="740.0" y="196.8" width="421.2" height="126.0" as="geometry"/></mxCell><mxCell id="n223" value="NON-FUNCTIONAL REQUIREMENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c2b39;strokeColor=#1c2b39;fontSize=7.6;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;dashed=0;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="740.0" y="196.8" width="421.2" height="14.2" as="geometry"/></mxCell><mxCell id="n224" value="• Avail